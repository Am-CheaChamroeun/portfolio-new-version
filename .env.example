# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# Optional: override the production URL (https origin, no trailing slash). By default the single `siteUrl` in
# src/data/portfolio.ts (https://amcheachamroeun.vercel.app) is used for canonical URLs, Open Graph, sitemap.xml,
# robots.txt and JSON-LD. Only set this when a custom domain replaces it.
# VITE_SITE_URL=https://your-custom-domain.example

# Optional: Google Search Console "HTML tag" verification token (only the content="…" value, never the whole tag).
# When set, the tag is written into the static HTML of every page at build time. Leave unset until you have a real token.
# VITE_GOOGLE_SITE_VERIFICATION=

# Optional: GitHub username for the System Monitor → GitHub tab (defaults to the one in socials.github.url)
# VITE_GITHUB_USERNAME=
# Optional: URL of a contributions JSON endpoint (see README → GitHub)
# VITE_GITHUB_CONTRIBUTIONS_URL=

# Optional: Cloudinary cloud NAME for project screenshots / demo videos. A public value; the built-in default (src/lib/cloudinary.ts) is used when this is unset.
# Never put an API key, API secret or upload preset in a VITE_ variable.
# VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Contact form: Web3Forms access key (https://web3forms.com → enter your email → the key is emailed to you).
# It is a public value by design, so VITE_ is fine, but restrict it to your domain in the Web3Forms dashboard.
# Without it the form falls back to opening the visitor's email app and never claims a message was sent.
VITE_WEB3FORMS_ACCESS_KEY=
